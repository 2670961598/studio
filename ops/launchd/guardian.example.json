{
  "_comment": "守护核配置模板（studio-dev-697；2026-11-04 ref=708 更新：daemon 只从部署树运行）。安装时替换 <...> 占位；本文件不含任何主机真实路径/凭据，可直接入仓。",
  "_deployment": "主工作区（<WORKSPACE>）只用于施工，可脏；daemon 的 cwd/入口全部指向部署树 <DEPLOY_WORKSPACE>（已验证 commit）。preflight = deploy.mjs check：部署树不干净/HEAD 漂移/tree digest 不符/依赖缺失时 guardian 拒绝启动 daemon（fail-closed，告警重试）。",
  "daemon": {
    "command": [
      "<NODE_BIN>",
      "apps/boot/src/main.ts",
      "<COMPANY_DIR>/daemon.yaml"
    ],
    "cwd": "<DEPLOY_WORKSPACE>",
    "preflight": [
      "<NODE_BIN>",
      "<DEPLOY_WORKSPACE>/scripts/ops/deploy.mjs",
      "check",
      "--deploy",
      "<DEPLOY_WORKSPACE>",
      "--state",
      "<DEPLOY_STATE>"
    ],
    "preflightRetryMs": 30000,
    "env": {
      "NODE_ENV": "production"
    }
  },
  "health": {
    "url": "http://127.0.0.1:8788/healthz",
    "intervalMs": 10000,
    "timeoutMs": 5000,
    "failuresBeforeRestart": 3,
    "startupGraceMs": 60000
  },
  "restart": {
    "initialBackoffMs": 2000,
    "maxBackoffMs": 60000,
    "multiplier": 2,
    "stopGraceMs": 15000
  },
  "crashLoop": {
    "windowMs": 600000,
    "maxRestarts": 5,
    "brakeMs": 900000
  },
  "paths": {
    "logDir": "<LOGDIR>",
    "daemonLog": "<LOGDIR>/daemon.log",
    "guardianLog": "<LOGDIR>/guardian.jsonl",
    "pidFile": "<LOGDIR>/daemon.pid",
    "alertsFile": "<LOGDIR>/alerts.jsonl"
  }
}
