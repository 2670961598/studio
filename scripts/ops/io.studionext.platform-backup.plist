<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  io.studionext.platform-backup.plist —— Taiga/Matrix 每日 04:30 备份（草案，2026-11-17 制作人批）
  安装（由 Lead/ops 执行；不随本文件自动安装）：
    sed -e "s#__REPO__#<部署树>#g" -e "s#__BACKUP_DIR__#<备份目录>#g" \
      io.studionext.platform-backup.plist > ~/Library/LaunchAgents/io.studionext.platform-backup.plist
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/io.studionext.platform-backup.plist
  卸载：launchctl bootout gui/$(id -u)/io.studionext.platform-backup
  备份目录缺省 <backupDir>（安装时替换 __BACKUP_DIR__）；日志同时落 <backupDir>/backup.log 与下面的 launchd 日志。
  chatd 备份（M4.5 增量，2026-11-19）：本 plist **只改说明不重装**——已装实例如需纳入公司 chatd SQLite，
  在 ProgramArguments 的脚本参数后追加（每公司一条，可重复）：
      <string>--chatd-db</string><string>&lt;companyDir&gt;/var/workbench/chat.db</string>
  或给 launchd 环境 PLATFORM_BACKUP_CHATD_DBS（冒号分隔多库）。库缺失自动 SKIP 不报错；
  产物 chatd-<slug>-<ts>.db.gz 与 Taiga/Matrix 同 manifest/同保留策略（详见脚本头注）。
  无 Docker 部署（M5-2 第一刀，2026-11-20）：脚本**自动探测** docker——CLI 缺失或 docker info 失败
  ＝不可用 → Taiga/Matrix/Matrix-config 段 SKIP（backup.log 明报 reason=docker-unavailable，
  SUMMARY 记 docker.skipped；**不算失败，exit 0**），chatd 备份/manifest/保留策略照常；
  docker 可用且未显式跳过时行为与原版一致（容器未运行仍 fail）。
  显式跳过（例如 docker info 可通但容器已弃用/损坏的机器）：ProgramArguments 追加
      <string>--skip-docker</string>
  计划任务无需因退 Docker 而重装/改动；日志面 SKIP 行可作巡检依据。
  core 事实源备份（M5-2 第二刀，2026-11-20）：Docker 退役后生产事实源全在外部数据盘（单点），
  本任务起随每日备份逐公司备三面——&lt;companyDir&gt;/platform（jsonl 树）、&lt;companyDir&gt;/ledger.sqlite
  （台账，sqlite3 .backup 热备）、&lt;companyDir&gt;/company（git 目录）。已装实例在 ProgramArguments
  的脚本参数后追加（每公司一条，可重复）：
      <string>--core-company</string><string>&lt;companyDir&gt;</string>
  或给 launchd 环境 PLATFORM_BACKUP_CORE_COMPANIES（冒号分隔多公司目录，与 flag 合并去重）。
  缺目录/缺文件自动 SKIP 不报错；产物 core-platform|core-ledger|core-company-&lt;slug&gt;-&lt;ts&gt;.*
  （全 600）与既有面同 manifest/同 7 天保留策略；SUMMARY 记 core.backed/core.skipped；
  两个同名公司目录（同 slug 冲突）用法错退出，绝不静默覆盖。
-->
<plist version="1.0">
<dict>
  <key>Label</key><string>io.studionext.platform-backup</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__REPO__/scripts/ops/platform-backup.sh</string>
    <string>--backup-dir</string>
    <string>__BACKUP_DIR__</string>
  </array>
  <key>WorkingDirectory</key><string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>__BACKUP_DIR__/backup.launchd.log</string>
  <key>StandardErrorPath</key><string>__BACKUP_DIR__/backup.launchd.err</string>
</dict>
</plist>
