{
  // V2 新套件类型门（MIG-02 / IMPL-02-03）：只覆盖 apps|packages 的 test/v2，与根门禁（src 面）分离。
  // 依据：plan/04 §1.9.2（include 仅 test/v2）、plan/03 §三、plan/05 IMPL-02-03、
  //       docs/v2/13 §1.4（类型门禁覆盖三态口径，TOOL-06）/§八-1（test 门禁三包红＝目标项，不作 MIG-02 出口）。
  // 纪律：extends 根 base **不放宽 strict**（v2/13 §1.3：测试断言的是语义，放宽即改变标尺）；
  //       旧测试不进本 program（旧测试红入 docs/baselines/old-tests-ledger.md 台账，不修不门）。
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // 只做类型门，不出产物（base 已设；此处显式重申门禁性质）
    "noEmit": true
  },
  "include": ["apps/*/test/v2/**/*.ts", "packages/*/test/v2/**/*.ts"],
  "exclude": ["**/node_modules/**", "**/dist/**"]
}
