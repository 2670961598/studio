{
  "name": "studio-next",
  "version": "0.1.0",
  "private": true,
  "description": "Studio Next —— AI 公司框架：调度、适配器、网关、面板与公司目录契约",
  "license": "MIT",
  "author": "Ye QingXin",
  "type": "module",
  "packageManager": "bun@1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "guard:boundaries": "node scripts/guards/boundaries.mjs",
    "test": "bun run guard:boundaries && vitest run --passWithNoTests",
    "typecheck:v2": "tsc --noEmit -p tsconfig.v2.json",
    "test:v2": "vitest run --config vitest.v2.config.ts",
    "verify:v2": "bun run guard:boundaries && bun run typecheck && bun run typecheck:v2 && bun run test:v2 && node scripts/verify/v2-suite-manifest.mjs && node scripts/verify/old-test-ledger.mjs",
    "daemon": "node apps/daemon/src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
